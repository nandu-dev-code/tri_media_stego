# Application Secret Key for session signing
SECRET_KEY=replace-with-a-secure-random-key

# Database URL:
# For local SQLite (default): sqlite:///stegano.db
# For MySQL: mysql+pymysql://username:password@localhost/stegano_db
# For PostgreSQL (e.g. Render / Railway): postgresql://username:password@host/dbname
DATABASE_URL=sqlite:///stegano.db
